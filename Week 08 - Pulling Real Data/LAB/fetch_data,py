"""
fetch_data.py - Week 8: get data from an API and save it as DATA/raw.csv.

Run it:  python fetch_data.py
"""
import os
import requests
import pandas as pd

# --- Settings (Your Steps 1 to 5) ---
URL = "https://earthquake.usgs.gov/fdsnws/event/1/query"
PARAMS = {
    "format": "geojson",
    "starttime": "2024-01-01",
    "endtime": "2024-01-31",
    "minmagnitude": 4.5
}
RECORDS_KEY = "features"

RENAME = {
    "properties_mag": "magnitude",
    "properties_place": "place",
    "properties_time": "time_ms",
    "geometry_coordinates": "coordinates"
}
KEEP = ["magnitude", "place", "time_ms", "coordinates"]
MUST_HAVE = ["magnitude", "place"]


# --- Functions (Step 6) ---

def get_data(url, params):
    """Step 2: Ask the API. Returns JSON, or None if it failed."""
    try:
        response = requests.get(url, params=params)
        response.raise_for_status() # Check for HTTP errors
        return response.json()
    except requests.exceptions.RequestException as e:
        print(f"Error fetching data: {e}")
        return None

def make_table(data, records_key):
    """Steps 3 and 4: Convert records to a table."""
    if not data:
        return None
    records = data[records_key] if records_key else data
    return pd.json_normalize(records, sep="_")

def tidy_data(df):
    """Step 5: Rename, keep, and drop empty rows."""
    if df is None:
        return None
    tidy = df.rename(columns=RENAME)
    tidy = tidy[KEEP]
    tidy = tidy.dropna(subset=MUST_HAVE)
    return tidy

def save_data(df, path):
    """Write the table to a CSV file."""
    if df is None:
        return
    
    # Ensure the folder exists (creates 'DATA' folder if missing)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    
    # Save the file without the index numbers
    df.to_csv(path, index=False)
    print(f"Success! Saved {len(df)} records to {path}")

# --- Main Execution ---
if __name__ == "__main__":
    print("Fetching data...")
    raw_data = get_data(URL, PARAMS)
    
    print("Building table...")
    table = make_table(raw_data, RECORDS_KEY)
    
    print("Tidying data...")
    final_table = tidy_data(table)
    
    print("Saving to file...")
    save_data(final_table, "DATA/raw.csv")